function(configure_capture_symbols directory)
    if(NOT ANYPS5_CAPTURE_SYMBOLS)
        return()
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
        message(FATAL_ERROR "ANYPS5_CAPTURE_SYMBOLS requires GCC or Clang debug information support")
    endif()
    get_property(captureTargets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(captureTarget IN LISTS captureTargets)
        get_target_property(captureSourceDirectory "${captureTarget}" SOURCE_DIR)
        file(RELATIVE_PATH captureRelativeDirectory "${PROJECT_SOURCE_DIR}/core" "${captureSourceDirectory}")
        if(IS_ABSOLUTE "${captureRelativeDirectory}" OR captureRelativeDirectory MATCHES "^\\.\\.(/|$)")
            continue()
        endif()
        get_target_property(captureTargetType "${captureTarget}" TYPE)
        if(captureTargetType MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            target_compile_options("${captureTarget}" PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:-g>")
        endif()
    endforeach()
    get_property(captureSubdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(captureSubdirectory IN LISTS captureSubdirectories)
        configure_capture_symbols("${captureSubdirectory}")
    endforeach()
endfunction()
